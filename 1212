<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>15分単位・勤務計算機</title>
    <style>
        :root { --primary: #4a90e2; --success: #2ecc71; --bg: #f5f7fa; --text: #2c3e50; }
        body { font-family: sans-serif; background: var(--bg); color: var(--text); margin: 0; display: flex; justify-content: center; align-items: center; min-height: 100vh; }
        .app-container { width: 100%; max-width: 500px; background: white; border-radius: 20px; shadow: 0 10px 25px rgba(0,0,0,0.1); overflow: hidden; display: flex; flex-direction: column; }
        .header { background: var(--primary); color: white; padding: 20px; text-align: center; font-weight: bold; }
        .content { padding: 20px; }
        .section { background: #f9fbff; border: 1px solid #e1e8f0; border-radius: 12px; padding: 15px; margin-bottom: 15px; }
        .radio-group { display: flex; gap: 8px; margin-top: 8px; }
        .radio-group input { display: none; }
        .radio-group label { flex: 1; background: white; border: 2px solid #cbd5e0; padding: 10px; text-align: center; border-radius: 8px; cursor: pointer; font-size: 0.9rem; }
        .radio-group input:checked + label { background: var(--primary); color: white; border-color: var(--primary); }
        #start-btn { background: var(--success); color: white; border: none; padding: 18px; font-size: 1.1rem; font-weight: bold; border-radius: 12px; width: 100%; cursor: pointer; }
        #status { text-align: center; color: #e67e22; font-weight: bold; margin-bottom: 10px; min-height: 1.5em; }
        #result { background: #fff; border: 2px solid #eee; border-radius: 12px; padding: 15px; margin-top: 15px; display: none; }
        .total-time { font-size: 2rem; color: #e74c3c; font-weight: bold; display: block; text-align: center; }
    </style>
</head>
<body>

<div class="app-container">
    <div class="header">15分単位計算パートナー</div>
    <div class="content">
        <div class="section">
            <span>日勤休憩 (5:00-17:00)</span>
            <div class="radio-group">
                <input type="radio" name="day-break" value="0" id="d0"><label for="d0">なし</label>
                <input type="radio" name="day-break" value="30" id="d30"><label for="d30">30分</label>
                <input type="radio" name="day-break" value="60" id="d60" checked><label for="d60">60分</label>
            </div>
        </div>
        <div class="section">
            <span>夜勤休憩 (17:00-1:00)</span>
            <div class="radio-group">
                <input type="radio" name="night-break" value="0" id="n0" checked><label for="n0">なし</label>
                <input type="radio" name="night-break" value="30" id="n30"><label for="n30">30分</label>
            </div>
        </div>

        <div id="status">「9時15分から18時45分」</div>
        <button id="start-btn">🎙 音声入力を開始</button>

        <div id="result"></div>
    </div>
</div>

<script>
    const startBtn = document.getElementById('start-btn');
    const resultDiv = document.getElementById('result');
    const statusP = document.getElementById('status');

    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

    if (!SpeechRecognition) {
        statusP.innerText = "エラー: お使いのブラウザは音声認識非対応です。Chromeをお試しください。";
        startBtn.disabled = true;
        startBtn.style.background = "#ccc";
    } else {
        const recognition = new SpeechRecognition();
        recognition.lang = 'ja-JP';

        startBtn.onclick = () => {
            try {
                recognition.start();
                statusP.innerText = "マイク起動中... 許可してください";
            } catch (e) {
                statusP.innerText = "起動済みです。お話しください。";
            }
        };

        recognition.onstart = () => { statusP.innerText = "聞き取り中... お話しください"; };
        
        recognition.onerror = (event) => {
            statusP.innerText = "エラー: " + event.error + " (マイク許可を確認してください)";
        };

        recognition.onresult = (event) => {
            const text = event.results[0][0].transcript;
            statusP.innerText = "認識: 「" + text + "」";
            processSpeech(text);
        };
    }

    function processSpeech(text) {
        const nums = text.match(/\d+/g); // 数字をすべて抽出
        if (!nums || nums.length < 2) {
            resultDiv.style.display = "block";
            resultDiv.innerHTML = "時間を正しく認識できませんでした。";
            return;
        }

        // 「9時15分から18時」などのパターンに対応
        let startH = parseInt(nums[0]);
        let startM = nums.length >= 3 && text.includes(nums[0] + "時" + nums[1]) ? parseInt(nums[1]) : 0;
        
        let endH, endM;
        if (nums.length >= 4) {
            endH = parseInt(nums[2]);
            endM = parseInt(nums[3]);
        } else if (nums.length === 3) {
            endH = parseInt(nums[2]);
            endM = 0;
        } else {
            endH = parseInt(nums[1]);
            endM = 0;
        }

        let startTotal = startH * 60 + startM;
        let endTotal = endH * 60 + endM;

        if (endTotal <= startTotal) endTotal += (24 * 60);

        const dayBreak = parseInt(document.querySelector('input[name="day-break"]:checked').value);
        const nightBreak = parseInt(document.querySelector('input[name="night-break"]:checked').value);

        const dayS = 5 * 60, dayE = 17 * 60, nightE = 25 * 60;

        function getOverlap(s1, e1, s2, e2) {
            return Math.max(0, Math.min(e1, e2) - Math.max(s1, s2));
        }

        let dRaw = getOverlap(startTotal, endTotal, dayS, dayE);
        let nRaw = getOverlap(startTotal, endTotal, dayE, nightE);

        let dFinal = Math.max(0, dRaw - (dRaw > 0 ? dayBreak : 0));
        let nFinal = Math.max(0, nRaw - (nRaw > 0 ? nightBreak : 0));
        let total = dFinal + nFinal;

        resultDiv.style.display = "block";
        resultDiv.innerHTML = `
            <div style="display:flex; justify-content:space-between;"><span>日勤(${dayBreak}分引)</span> <b>${Math.floor(dFinal/60)}h ${dFinal%60}m</b></div>
            <div style="display:flex; justify-content:space-between;"><span>夜勤(${nightBreak}分引)</span> <b>${Math.floor(nFinal/60)}h ${nFinal%60}m</b></div>
            <hr>
            <span class="total-time">${Math.floor(total/60)}時間${total%60}分</span>
        `;
    }
</script>
</body>
</html>
